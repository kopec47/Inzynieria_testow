{
    "configurations": [
        {
            "name": "PlatformIO ESP32-S3",
            "includePath": [
                "${workspaceFolder}/esp32_bme280_csv/src",
                "${workspaceFolder}/esp32_bme280_csv/.pio/libdeps/esp32-s3-devkitc-1/Adafruit BME280 Library",
                "${workspaceFolder}/esp32_bme280_csv/.pio/libdeps/esp32-s3-devkitc-1/Adafruit BusIO",
                "${workspaceFolder}/esp32_bme280_csv/.pio/libdeps/esp32-s3-devkitc-1/Adafruit Unified Sensor",
                "C:/.platformio/packages/framework-arduinoespressif32/cores/esp32",
                "C:/.platformio/packages/framework-arduinoespressif32/variants/esp32s3",
                "C:/.platformio/packages/framework-arduinoespressif32/libraries/Wire/src",
                "C:/.platformio/packages/framework-arduinoespressif32/libraries/SPI/src",
                "C:/.platformio/packages/framework-arduinoespressif32/tools/sdk/esp32s3/include/**"
            ],
            "defines": [
                "ARDUINO=10805",
                "ARDUINO_ARCH_ESP32",
                "ARDUINO_ESP32S3_DEV",
                "ESP32",
                "ESP_PLATFORM"
            ],
            "compilerPath": "C:/.platformio/packages/toolchain-xtensa-esp32s3/bin/xtensa-esp32s3-elf-g++.exe",
            "cStandard": "c11",
            "cppStandard": "gnu++11",
            "intelliSenseMode": "gcc-x64"
        }
    ],
    "version": 4
}
